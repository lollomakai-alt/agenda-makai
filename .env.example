# =============================================================================
# AGENDA MAKAI — variabili del progetto Vercel "agenda-makai"
# =============================================================================
# Dove si impostano:
#   - Produzione: Vercel -> progetto agenda-makai -> Settings -> Environment
#     Variables -> Production (poi Redeploy).
#   - Locale: copia questo file in makai-agenda/.env e riavvia `npm run dev`.
#
# Le variabili con prefisso VITE_ vengono incluse nel bundle del browser:
# non metterci mai segreti, service-role key o password.
# Le altre sono lette solo dalla funzione serverless api/agenda-gateway.js.
# =============================================================================


# -----------------------------------------------------------------------------
# BROWSER (pubbliche, prefisso VITE_)
# -----------------------------------------------------------------------------

# [OBBLIGATORIA] URL del progetto Supabase condiviso, forma https://xxxxx.supabase.co.
# Usata dal login Supabase Auth e dal realtime del calendario.
VITE_SUPABASE_URL=

# [OBBLIGATORIA] Chiave publishable/anon dello stesso progetto Supabase.
# È una chiave pubblica: va bene nel browser, NON usare service_role o sb_secret_.
VITE_SUPABASE_PUBLISHABLE_KEY=

# [OBBLIGATORIA] Dominio pubblico HTTPS del Sito Makai.
# Usato per costruire il link alla pagina privacy nei messaggi di conferma.
VITE_PUBLIC_SITE_URL=https://www.makaipigneto.it


# -----------------------------------------------------------------------------
# SERVER — gateway Vercel (nessun prefisso VITE_)
# -----------------------------------------------------------------------------

# [OBBLIGATORIA] Origine HTTPS del Backend Makai.
# In locale: http://127.0.0.1:8000
# In produzione: https://backend-makai.vercel.app
# Senza /api, senza path e senza slash finale.
API_PROXY_TARGET=http://127.0.0.1:8000

# [OBBLIGATORIA] Almeno 32 caratteri, senza spazi.
# Deve essere IDENTICA a AGENDA_BACKEND_SECRET del progetto Vercel
# "backend-makai". Il gateway la invia nell'header X-Agenda-Backend-Key.
AGENDA_BACKEND_SECRET=


# -----------------------------------------------------------------------------
# SUPABASE EDGE FUNCTIONS — NON sono variabili Vercel
# -----------------------------------------------------------------------------
# Si impostano in Supabase -> Edge Functions -> Secrets del progetto Supabase
# condiviso, non in questo file e non nel progetto Vercel.
#
# web-push-admin:
#   MAKAI_PUSH_SECRET        deve coincidere con quella del Backend
#   MAKAI_PUSH_SECRET_NEXT   opzionale, solo durante una rotazione
#   VAPID_PUBLIC_KEY         obbligatoria
#   VAPID_PRIVATE_KEY        obbligatoria, solo server
#   VAPID_SUBJECT            es. mailto:admin@makaipigneto.it
#
# send-booking-email:
#   RESEND_API_KEY           obbligatoria
#
# resend-webhook:
#   RESEND_WEBHOOK_SECRET    obbligatoria
#
# create-booking:
#   nessun secret aggiuntivo (usa le variabili Supabase automatiche)
#
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY sono iniettate
# automaticamente da Supabase nelle Edge Function: non vanno configurate qui.
# -----------------------------------------------------------------------------
